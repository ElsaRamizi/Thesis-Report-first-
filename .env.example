# MindMetrics — deployment environment variables
#
# Copy this file to `.env` (or export variables in your shell / CI / hosting panel)
# and replace placeholder values before running in production.
#
# Backend (Spring Boot) reads these from the process environment.
# Frontend (Vite) only reads variables prefixed with VITE_ — see frontend/.env.example
#
# Local development (default):
#   SPRING_PROFILES_ACTIVE=dev   → uses demo/src/main/resources/application-dev.properties
# Production:
#   SPRING_PROFILES_ACTIVE=prod  → uses application-prod.properties (stricter, no weak defaults)

# =============================================================================
# Spring profile & server
# =============================================================================

# dev | prod
SPRING_PROFILES_ACTIVE=dev

# HTTP port for the Spring Boot API (default: 8080)
PORT=8080

# =============================================================================
# Database (MySQL) — REQUIRED in prod
# =============================================================================

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/mindmetrics
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me

# Optional JDBC driver override (default: com.mysql.cj.jdbc.Driver)
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# Dev only: Hibernate schema mode (prod profile uses validate)
# SPRING_JPA_HIBERNATE_DDL_AUTO=update

# =============================================================================
# Security — REQUIRED in prod
# =============================================================================

# JWT signing secret — at least 32 characters; never commit the real value
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# AES-GCM key for encrypting clinical notes & annotation content at rest
# At least 32 characters; never commit the real value
APP_ENCRYPTION_KEY=change-me-to-a-long-random-encryption-key-32-chars

# Access token lifetime in milliseconds (default dev: 86400000 = 24h, prod default: 3600000 = 1h)
JWT_EXPIRATION=86400000

# Refresh token lifetime in milliseconds (default: 604800000 = 7 days)
JWT_REFRESH_EXPIRATION=604800000

# CORS: comma-separated frontend origin(s) allowed to call the API with cookies
# Dev example:  http://localhost:5173,http://127.0.0.1:5173
# Prod example: https://mindmetrics.example.com
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://127.0.0.1:5173

# Set true when serving the API over HTTPS (prod profile sets this automatically)
APP_COOKIE_SECURE=false

# =============================================================================
# TLS / HTTPS (prod) — enable when terminating TLS in Spring Boot
# =============================================================================
# If TLS is handled by a reverse proxy (nginx, Caddy, cloud load balancer),
# leave SERVER_SSL_ENABLED=false and terminate TLS at the proxy instead.

# SERVER_SSL_ENABLED=true
# SERVER_SSL_KEY_STORE=classpath:keystore.p12
# SERVER_SSL_KEY_STORE_PASSWORD=change-me
# SERVER_SSL_KEY_STORE_TYPE=PKCS12

# =============================================================================
# Frontend (Vite) — copy to frontend/.env for local dev or set in CI build
# =============================================================================
# VITE_API_BASE_URL=http://localhost:8080
# Production build example:
# VITE_API_BASE_URL=https://api.mindmetrics.example.com

# =============================================================================
# Quick start
# =============================================================================
#
# 1. Create MySQL database: mindmetrics
# 2. Export variables above (or use a .env loader in your deployment tool)
# 3. Backend:  cd demo && mvn spring-boot:run
# 4. Frontend: cd frontend && cp .env.example .env && npm run dev
#
# Production checklist:
#   - SPRING_PROFILES_ACTIVE=prod
#   - Set JWT_SECRET, APP_ENCRYPTION_KEY, DB credentials (no defaults)
#   - APP_CORS_ALLOWED_ORIGIN_PATTERNS = your frontend URL only
#   - APP_COOKIE_SECURE=true (or HTTPS via reverse proxy + secure cookies)
#   - Build frontend with VITE_API_BASE_URL pointing at the public API URL
