# Frontend environment variables (Vite)
# Copy to `.env` for local development:  cp .env.example .env
#
# Backend / database / JWT / encryption variables are documented in the repo root:
#   ../.env.example

# Public URL of the Spring Boot API (must match APP_CORS_ALLOWED_ORIGIN_PATTERNS on backend)
VITE_API_BASE_URL=http://localhost:8080

# Production build example:
# VITE_API_BASE_URL=https://api.mindmetrics.example.com
